# Public canonical URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required server-only admin credentials. Never commit real values.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Google OAuth for /admin. ADMIN_GOOGLE_EMAILS accepts a comma-separated allowlist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_GOOGLE_EMAILS=a.madibaev@gmail.com

# Optional emergency password fallback. Leave empty for Google-only access.
ADMIN_PASSWORD=

# Local/self-hosted persistent JSON + media storage. Docker overrides this to /app/data.
MGS_DATA_DIR=.data
MGS_COOKIE_SECURE=false

# Set true only when requests come through Cloudflare proxy and its client-IP
# header is trusted by your infrastructure.
MGS_TRUST_CLOUDFLARE=false

# Public enquiry anti-spam. Turnstile can stay disabled during local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# On Vercel, leave MGS_DATA_DIR unset and connect a private Blob store instead.
BLOB_READ_WRITE_TOKEN=

# Optional server-only OpenRouter access for SEO and copywriting tools in the admin editor.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
